{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FATHER Risk Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk_id",
    "sector_id",
    "business_process",
    "risk_owner",
    "scenario",
    "consequences",
    "constraints",
    "assessment_status"
  ],
  "properties": {
    "risk_id": {
      "type": "string",
      "minLength": 1
    },
    "sector_id": {
      "type": "string",
      "minLength": 1
    },
    "business_process": {
      "type": "string",
      "minLength": 1
    },
    "risk_owner": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "consequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rto_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rpo_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "mtpd_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "sle_rub": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "aro_per_year": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ale_rub": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "loss_estimate_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessment_status": {
      "enum": [
        "synthetic",
        "draft",
        "review",
        "approved"
      ]
    },
    "residual_risk_decision": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}